; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="潮森群島 Tidegrove Isles"
config/description="原創 2.5D 像素立體劇場・伴獸認養 RPG：御三家認養日 Vertical Slice。"
config/version="0.4.0"
run/main_scene="res://scenes/main/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]

DataRegistry="*res://scripts/core/data_registry.gd"
EventFlagStore="*res://scripts/core/event_flag_store.gd"
PartyService="*res://scripts/core/party_service.gd"
InventoryService="*res://scripts/core/inventory_service.gd"
GameState="*res://scripts/core/game_state.gd"
SaveService="*res://scripts/persistence/save_service.gd"
AudioManager="*res://scripts/core/audio_manager.gd"
DialogueManager="*res://scripts/core/dialogue_manager.gd"
InputRouter="*res://scripts/core/input_router.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
DebugTour="*res://scripts/core/debug_tour.gd"
TouchControls="*res://scenes/ui/touch_controls.tscn"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/fusion-pixel-12px-tc.ttf"
theme/default_font_size=12
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

